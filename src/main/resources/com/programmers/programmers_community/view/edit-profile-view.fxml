<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox fillWidth="false" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="500.0" styleClass="root-horizontal" stylesheets="@../css/css.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.programmers.programmers_community.controller.EditProfileController">
    <children>
        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="500.0">
            <children>
                <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/edit_profile.png" />
                    </image>
                </ImageView>
                <Label fx:id="lblHead" prefHeight="100.0" prefWidth="300.0" styleClass="main-title" text="Edit Profile">
                    <font>
                        <Font name="Arial" size="34.0" />
                    </font>
                    <HBox.margin>
                        <Insets left="50.0" />
                    </HBox.margin>
                </Label>
            </children>
            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>
        </HBox>
        <VBox fillWidth="false" prefHeight="200.0" prefWidth="500.0" styleClass="card">
            <children>
                <HBox fillHeight="false" prefHeight="120.0" prefWidth="500.0">
                    <children>
                        <VBox alignment="CENTER" fillWidth="false" prefHeight="120.0" prefWidth="250.0">
                            <children>
                                <Label styleClass="label-blue" text="Password:">
                                    <font>
                                        <Font name="Arial" size="20.0" />
                                    </font>
                                </Label>
                                <PasswordField fx:id="pfPassword" prefHeight="35.0" prefWidth="150.0" promptText="Password" styleClass="text-field">
                                    <VBox.margin>
                                        <Insets top="10.0" />
                                    </VBox.margin>
                                </PasswordField>
                                <Label fx:id="lblPasswordErrors" styleClass="label-error">
                                    <VBox.margin>
                                        <Insets top="5.0" />
                                    </VBox.margin></Label>
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" fillWidth="false" prefHeight="120.0" prefWidth="250.0">
                            <children>
                                <Label styleClass="label-blue" text="Language:">
                                    <font>
                                        <Font name="Arial" size="20.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="cbLanguages" prefHeight="30.0" prefWidth="135.0" promptText="Languages" styleClass="combo-box">
                                    <VBox.margin>
                                        <Insets top="10.0" />
                                    </VBox.margin>
                                </ComboBox>
                        <Label />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <HBox alignment="CENTER" fillHeight="false" prefHeight="88.0" prefWidth="480.0">
                    <children>
                        <Label prefHeight="25.0" prefWidth="100.0" styleClass="label-blue" text="Gender:" textFill="#0068ff">
                            <font>
                                <Font name="Arial" size="20.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="15.0" right="20.0" />
                            </HBox.margin>
                        </Label>
                        <RadioButton fx:id="rbMan" mnemonicParsing="false" text="Man">
                            <HBox.margin>
                                <Insets right="20.0" />
                            </HBox.margin>
                            <font>
                                <Font name="Arial" size="14.0" />
                            </font>
                            <toggleGroup>
                                <ToggleGroup fx:id="tgGender" />
                            </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="rbWoman" mnemonicParsing="false" text="Woman" toggleGroup="$tgGender">
                            <HBox.margin>
                                <Insets right="20.0" />
                            </HBox.margin>
                            <font>
                                <Font name="Arial" size="14.0" />
                            </font>
                        </RadioButton>
                        <RadioButton fx:id="rbOther" mnemonicParsing="false" text="Other" toggleGroup="$tgGender">
                            <font>
                                <Font name="Arial" size="14.0" />
                            </font>
                        </RadioButton>
                    </children>
                </HBox>
            </children>
            <VBox.margin>
                <Insets left="10.0" right="10.0" top="10.0" />
            </VBox.margin>
        </VBox>
        <HBox alignment="CENTER" fillHeight="false" prefHeight="100.0" prefWidth="500.0">
            <children>
                <Button fx:id="btnReturn" mnemonicParsing="false" onAction="#onReturn" prefHeight="40.0" prefWidth="125.0" styleClass="btn-secondary" text="Return Home">
                    <graphic>
                        <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/return.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <HBox.margin>
                        <Insets right="40.0" />
                    </HBox.margin>
                </Button>
                <Button fx:id="btnConfirm" mnemonicParsing="false" onAction="#onConfirm" prefHeight="40.0" prefWidth="145.0" styleClass="btn-primary" text="Confirm Changes">
                    <graphic>
                        <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/confirm.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <HBox.margin>
                        <Insets left="40.0" />
                    </HBox.margin>
                </Button>
            </children>
            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>
