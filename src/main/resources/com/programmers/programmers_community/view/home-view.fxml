<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" fillWidth="false" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="600.0" styleClass="root-horizontal" stylesheets="@../css/css.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.programmers.programmers_community.controller.HomeController">
   <children>
      <HBox alignment="CENTER" prefHeight="125.0" prefWidth="600.0">
         <children>
            <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/welcome.png" />
               </image></ImageView>
            <Label fx:id="lblWelcome" prefHeight="125.0" prefWidth="325.0" styleClass="main-title" text="Welcome!" wrapText="true">
               <font>
                  <Font name="Arial" size="34.0" />
               </font>
               <HBox.margin>
                  <Insets left="50.0" />
               </HBox.margin></Label>
            <Button fx:id="btnLogOut" mnemonicParsing="false" onAction="#onLogOut" prefHeight="40.0" prefWidth="105.0" styleClass="btn-primary" text="Log Out">
               <graphic>
                  <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/log_out.png" />
                     </image></ImageView>
               </graphic>
            </Button>
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="600.0">
         <children>
            <Label styleClass="label-blue" text="Filter by language">
               <HBox.margin>
                  <Insets left="15.0" right="20.0" />
               </HBox.margin>
               <font>
                  <Font size="16.0" />
               </font></Label>
            <ComboBox fx:id="cbLanguages" onAction="#onLanguageSelection" prefWidth="150.0" promptText="Language" styleClass="combo-box" />
         </children>
      </HBox>
      <HBox alignment="CENTER" prefHeight="154.0" prefWidth="550.0" styleClass="card">
         <children>
            <TableView fx:id="tblUsers" prefHeight="25.0" prefWidth="550.0">
               <columns>
                  <TableColumn fx:id="colUser" prefWidth="75.0" text="User" />
                  <TableColumn fx:id="colGender" prefWidth="75.0" text="Gender" />
                  <TableColumn fx:id="colLanguage" prefWidth="75.0" text="Language" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children></HBox>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="600.0">
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
         <children>
            <Button fx:id="btnEditProfile" mnemonicParsing="false" onAction="#onEditProfile" prefHeight="40.0" prefWidth="115.0" styleClass="btn-secondary" text="Edit Profile">
               <HBox.margin>
                  <Insets left="15.0" right="60.0" />
               </HBox.margin>
               <graphic>
                  <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/edit_profile.png" />
                     </image></ImageView>
               </graphic></Button>
            <Button mnemonicParsing="false" onAction="#onExcel" prefHeight="40.0" prefWidth="105.0" styleClass="btn-secondary" text="Excel">
               <HBox.margin>
                  <Insets left="60.0" right="40.0" />
               </HBox.margin>
               <graphic>
                  <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/excel.png" />
                     </image></ImageView>
               </graphic></Button>
            <Button mnemonicParsing="false" onAction="#onPdf" prefHeight="40.0" prefWidth="105.0" styleClass="btn-secondary" text="PDF">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
               <graphic>
                  <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/pdf.png" />
                     </image></ImageView>
               </graphic></Button>
            <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
               <HBox.margin>
                  <Insets left="15.0" />
               </HBox.margin>
               <image>
                  <Image url="@../images/book.png" />
               </image>
            </ImageView>
         </children></HBox>
   </children>
</VBox>