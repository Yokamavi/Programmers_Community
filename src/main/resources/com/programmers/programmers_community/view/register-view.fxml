<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" fillWidth="false" prefHeight="550.0" prefWidth="450" styleClass="root" stylesheets="@../css/css.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.programmers.programmers_community.controller.RegisterController">
    <children>
        <HBox fx:id="Head" alignment="TOP_CENTER" prefHeight="100.0" prefWidth="450.0">
            <children>
                <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/user_register.png" />
                    </image>
                </ImageView>
                <Label prefHeight="100.0" prefWidth="250.0" styleClass="main-title" text="User Registration" wrapText="true">
                    <HBox.margin>
                        <Insets left="50.0" />
                    </HBox.margin>
                    <font>
                        <Font name="Arial Bold" size="34.0" />
                    </font>
                </Label>
            </children>
            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>
        </HBox>
        <VBox alignment="TOP_CENTER" fillWidth="false" prefHeight="300.0" prefWidth="450.0" styleClass="card">
            <children>
                <HBox alignment="CENTER_LEFT" fillHeight="false" prefHeight="100.0" prefWidth="450.0">
                    <children>
                        <Label prefHeight="25.0" prefWidth="115.0" styleClass="label-blue" text="Username:" textFill="#0068ff">
                            <font>
                                <Font name="Arial" size="20.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="15.0" right="20.0" />
                            </HBox.margin>
                        </Label>
                        <TextField fx:id="txtUserRegister" alignment="CENTER" prefHeight="35.0" prefWidth="150.0" promptText="Username (min. 5)">
                            <HBox.margin>
                                <Insets right="20.0" />
                            </HBox.margin>
                        </TextField>
                        <Label fx:id="lblUserErrors" prefHeight="35.0" prefWidth="115.0" styleClass="label-error" wrapText="true" />
                    </children>
                    <VBox.margin>
                        <Insets />
                    </VBox.margin>
                </HBox>
                <HBox alignment="CENTER_LEFT" fillHeight="false" prefHeight="100.0" prefWidth="450.0">
                    <children>
                        <Label prefHeight="25.0" prefWidth="115.0" styleClass="label-blue" text="Password:" textFill="#0068ff">
                            <font>
                                <Font name="Arial" size="20.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="15.0" right="20.0" />
                            </HBox.margin>
                        </Label>
                        <PasswordField fx:id="pfPasswordRegister" alignment="CENTER" prefHeight="35.0" prefWidth="150.0" promptText="Password">
                            <HBox.margin>
                                <Insets right="20.0" />
                            </HBox.margin>
                        </PasswordField>
                        <Label fx:id="lblPasswordErrors" prefHeight="35.0" prefWidth="115.0" styleClass="label-error" wrapText="true" />
                    </children>
                    <VBox.margin>
                        <Insets />
                    </VBox.margin>
                </HBox>
                <HBox alignment="CENTER_LEFT" fillHeight="false" prefHeight="100.0" prefWidth="450.0">
                    <children>
                        <Label prefHeight="25.0" prefWidth="100.0" styleClass="label-blue" text="Gender:" textFill="#0068ff">
                            <font>
                                <Font name="Arial" size="20.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="15.0" right="20.0" />
                            </HBox.margin>
                        </Label>
                        <RadioButton fx:id="rbMan" mnemonicParsing="false" text="Man">
                            <HBox.margin>
                                <Insets right="20.0" />
                            </HBox.margin>
                            <font>
                                <Font name="Arial" size="14.0" />
                            </font>
                            <toggleGroup>
                                <ToggleGroup fx:id="tgGender" />
                            </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="rbWoman" mnemonicParsing="false" text="Woman" toggleGroup="$tgGender">
                            <HBox.margin>
                                <Insets right="20.0" />
                            </HBox.margin>
                            <font>
                                <Font name="Arial" size="14.0" />
                            </font>
                        </RadioButton>
                        <RadioButton fx:id="rbOther" mnemonicParsing="false" text="Other" toggleGroup="$tgGender">
                            <font>
                                <Font name="Arial" size="14.0" />
                            </font>
                        </RadioButton>
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" fillHeight="false" layoutX="10.0" layoutY="142.0" prefHeight="70.0" prefWidth="430.0">
                    <children>
                        <Label prefHeight="25.0" prefWidth="115.0" styleClass="label-blue" text="Language:" textFill="#0068ff">
                            <font>
                                <Font name="Arial" size="20.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="15.0" right="20.0" />
                            </HBox.margin>
                        </Label>
                        <ComboBox fx:id="cbLanguages" prefHeight="30.0" prefWidth="135.0" promptText="Languages" styleClass="combo-box">
                            <HBox.margin>
                                <Insets right="15.0" />
                            </HBox.margin>
                        </ComboBox>
                    </children>
                </HBox>
            </children>
            <VBox.margin>
                <Insets left="10.0" right="10.0" top="10.0" />
            </VBox.margin>
        </VBox>
        <HBox alignment="CENTER" fillHeight="false" prefHeight="100.0" prefWidth="450.0">
            <children>
                <Button fx:id="btnSignUp" mnemonicParsing="false" onAction="#onSignUp" prefHeight="40.0" prefWidth="105.0" styleClass="btn-secondary" text="Sign Up">
                    <HBox.margin>
                        <Insets right="40.0" />
                    </HBox.margin>
                    <graphic>
                        <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/user_register.png" />
                            </image></ImageView>
                    </graphic>
                </Button>
                <Button fx:id="btnReturn" layoutX="78.0" layoutY="43.0" mnemonicParsing="false" onAction="#onReturn" prefHeight="40.0" prefWidth="145.0" styleClass="btn-secondary" text="Return to Log In" wrapText="true">
                    <graphic>
                        <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/return.png" />
                            </image></ImageView>
                    </graphic>
                    <HBox.margin>
                        <Insets left="40.0" />
                    </HBox.margin>
                </Button>
            </children>
            <VBox.margin>
                <Insets bottom="20.0" top="30.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>
